GITHUB_TOKEN=ghp_your_token_here
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here
API_KEY=your-api-key
# LLM backend: ollama (default, local compose) | openai (OpenAI-compatible gateway)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:27b
# For LLM_PROVIDER=openai — point at any OpenAI-compatible gateway:
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://litellm:4000/v1
# LLM_MODEL=fabric-fast
# LLM_API_KEY=sk-agent-key
MCP_SERVER_URL=http://github-mcp:3000
LOG_LEVEL=INFO
